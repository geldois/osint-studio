#!/usr/bin/env bash
set -euo pipefail

_SHELL_FILES=(.githooks/pre-commit .githooks/pre-merge-commit scripts/run scripts/run.test.sh)
_WORKFLOW_FILES=(.github/workflows/release.yml)
_REPORT_PATH="build/reports/gates.json"
_TREE_HASH_FILE="build/.gate-tree-hash"
_TREE_REPORT_FILE="build/.gate-tree-report"
_TREE_EXIT_FILE="build/.gate-tree-exit"

root="$(git rev-parse --show-toplevel)"
cd "$root"

report=""
failed=0
gate_names=()
gate_statuses=()
gate_durations=()
gate_outputs=()

gate() {
    local name="$1"
    shift
    local start elapsed out status
    start="$(date +%s)"
    if out="$("$@" 2>&1)"; then
        status="pass"
    else
        status="fail"
        failed=1
    fi
    elapsed=$(($(date +%s) - start))
    report+=$'\n'"[${status^^}] ${name} (${elapsed}s)"
    if [ "$status" = "fail" ]; then
        report+=$'\n'"${out}"
    fi
    gate_names+=("$name")
    gate_statuses+=("$status")
    gate_durations+=("$elapsed")
    gate_outputs+=("$out")
}

write_report() {
    mkdir -p "$(dirname "$_REPORT_PATH")"
    local gate_json_lines=()
    local i
    for i in "${!gate_names[@]}"; do
        gate_json_lines+=("$(jq -n \
            --arg name "${gate_names[$i]}" \
            --arg status "${gate_statuses[$i]}" \
            --argjson duration "${gate_durations[$i]}" \
            --arg output "${gate_outputs[$i]}" \
            '{name: $name, status: $status, duration_s: $duration, output: $output}')")
    done
    printf '%s\n' "${gate_json_lines[@]}" | jq -s \
        --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --argjson passed "$([ "$failed" = 0 ] && echo true || echo false)" \
        '{generated_at: $generated_at, passed: $passed, gates: .}' \
        >"$_REPORT_PATH"
}

run_check() {
    gate shellcheck mise exec -- shellcheck "${_SHELL_FILES[@]}"
    gate shfmt mise exec -- shfmt -d "${_SHELL_FILES[@]}"
    gate run-tests bash scripts/run.test.sh
    gate actionlint mise exec -- actionlint "${_WORKFLOW_FILES[@]}"
    gate dprint mise exec -- dprint check
    gate lock-check mise exec -- pnpm install --frozen-lockfile

    if [ "$failed" = 0 ]; then
        gate eslint mise exec -- pnpm run lint
        gate prettier mise exec -- pnpm exec prettier --check .
        gate type-check mise exec -- pnpm run type-check
        gate build mise exec -- pnpm run build
        gate vitest mise exec -- pnpm run test
        gate markdownlint mise exec -- pnpm exec markdownlint-cli2 "**/*.md"
    fi

    write_report
    printf '%s\n' "$report"
    [ "$failed" = 0 ]
}

tree_hash() {
    git ls-files -z | xargs -0 sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1
}

run_precommit() {
    local staged_files=() f
    while IFS= read -r f; do
        [ -n "$f" ] && staged_files+=("$f")
    done < <(git diff --name-only --cached)

    run_fix >/dev/null

    local hash
    hash="$(tree_hash)"

    if [ -f "$_TREE_HASH_FILE" ] && [ "$(cat "$_TREE_HASH_FILE")" = "$hash" ] &&
        [ -f "$_TREE_REPORT_FILE" ] && [ -f "$_TREE_EXIT_FILE" ]; then
        local cached_status
        cached_status="$(cat "$_TREE_EXIT_FILE")"
        if [ "$cached_status" -ne 0 ] && [ "${#staged_files[@]}" -gt 0 ]; then
            git reset -q -- "${staged_files[@]}"
        fi
        cat "$_TREE_REPORT_FILE"
        return "$cached_status"
    fi

    local out status=0
    out="$(run_check 2>&1)" || status=$?

    if [ "$status" -ne 0 ] && [ "${#staged_files[@]}" -gt 0 ]; then
        git reset -q -- "${staged_files[@]}"
    fi

    mkdir -p "$(dirname "$_TREE_HASH_FILE")"
    printf '%s' "$hash" >"$_TREE_HASH_FILE"
    printf '%s' "$status" >"$_TREE_EXIT_FILE"
    printf '%s' "$out" >"$_TREE_REPORT_FILE"

    printf '%s\n' "$out"
    return "$status"
}

is_shell_file() {
    local needle="$1" candidate
    for candidate in "${_SHELL_FILES[@]}"; do
        [ "$needle" = "$candidate" ] && return 0
    done
    return 1
}

run_fix() {
    local files=("$@")
    if [ "${#files[@]}" -eq 0 ]; then
        mapfile -t files < <(git ls-files '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.json' '*.md' '*.css' '*.toml' '*.yaml' '*.yml' '*.sh' | sort -u)
        files+=("${_SHELL_FILES[@]}")
    fi

    local -A staged=()
    local staged_file
    while IFS= read -r staged_file; do
        [ -n "$staged_file" ] && staged["$staged_file"]=1
    done < <(git diff --name-only --cached)

    local prettier_files=() eslint_files=() dprint_files=() markdownlint_files=() shfmt_files=() staged_files=()
    local file
    for file in "${files[@]}"; do
        [ -f "$file" ] || continue
        [ -n "${staged[$file]:-}" ] && staged_files+=("$file")
        case "$file" in
        *.ts | *.tsx | *.js | *.jsx | *.mjs | *.json | *.md | *.css) prettier_files+=("$file") ;;
        esac
        case "$file" in
        *.ts | *.tsx | *.js | *.jsx | *.mjs) eslint_files+=("$file") ;;
        esac
        case "$file" in
        *.toml | *.yaml | *.yml) dprint_files+=("$file") ;;
        esac
        case "$file" in
        *.md) markdownlint_files+=("$file") ;;
        esac
        case "$file" in
        *.sh) shfmt_files+=("$file") ;;
        esac
        is_shell_file "$file" && shfmt_files+=("$file")
    done

    local did_something=0
    if [ "${#eslint_files[@]}" -gt 0 ]; then
        mise exec -- pnpm exec eslint --fix "${eslint_files[@]}" >/dev/null 2>&1 || true
        echo "eslint --fix: ${#eslint_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#dprint_files[@]}" -gt 0 ]; then
        mise exec -- dprint fmt "${dprint_files[@]}" >/dev/null 2>&1 || true
        echo "dprint fmt: ${#dprint_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#shfmt_files[@]}" -gt 0 ]; then
        mise exec -- shfmt -w "${shfmt_files[@]}" >/dev/null 2>&1 || true
        echo "shfmt -w: ${#shfmt_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#markdownlint_files[@]}" -gt 0 ]; then
        mise exec -- pnpm exec markdownlint-cli2 --fix "${markdownlint_files[@]}" >/dev/null 2>&1 || true
        echo "markdownlint --fix: ${#markdownlint_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#prettier_files[@]}" -gt 0 ]; then
        mise exec -- pnpm exec prettier --write "${prettier_files[@]}" >/dev/null 2>&1 || true
        echo "prettier: ${#prettier_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#staged_files[@]}" -gt 0 ]; then
        git add -- "${staged_files[@]}"
    fi

    [ "$did_something" = 0 ] && echo "fix: nothing to do"
    return 0
}

run_verify() {
    run_fix "$@" >/dev/null

    local out status=0
    out="$(run_check 2>&1)" || status=$?

    if [ "$status" = 0 ]; then
        echo "verify: ok"
    else
        printf '%s\n' "$out"
    fi

    echo
    echo "note: this is the same fix + check the git hook runs on every commit" \
        "and merge attempt — use verify only for a quick manual pass."

    return "$status"
}

main() {
    cmd="${1:-}"
    [ "$#" -gt 0 ] && shift

    case "$cmd" in
    check) run_check ;;
    fix) run_fix "$@" ;;
    verify) run_verify "$@" ;;
    precommit) run_precommit ;;
    *)
        echo "usage: scripts/run <check|fix|verify|precommit> [files...]" >&2
        exit 1
        ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
