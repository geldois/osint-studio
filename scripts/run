#!/usr/bin/env bash
set -euo pipefail

_SHELL_FILES=(.githooks/pre-commit .githooks/pre-merge-commit scripts/run)
_WORKFLOW_FILES=(.github/workflows/release.yml)
_REPORT_PATH="build/reports/gates.json"

root="$(git rev-parse --show-toplevel)"
cd "$root"

report=""
failed=0
gate_names=()
gate_statuses=()
gate_durations=()
gate_outputs=()

gate() {
    local name="$1"
    shift
    local start elapsed out status
    start="$(date +%s)"
    if out="$("$@" 2>&1)"; then
        status="pass"
    else
        status="fail"
        failed=1
    fi
    elapsed=$(($(date +%s) - start))
    report+=$'\n'"[${status^^}] ${name} (${elapsed}s)"
    if [ "$status" = "fail" ]; then
        report+=$'\n'"${out}"
    fi
    gate_names+=("$name")
    gate_statuses+=("$status")
    gate_durations+=("$elapsed")
    gate_outputs+=("$out")
}

write_report() {
    mkdir -p "$(dirname "$_REPORT_PATH")"
    local gate_json_lines=()
    local i
    for i in "${!gate_names[@]}"; do
        gate_json_lines+=("$(jq -n \
            --arg name "${gate_names[$i]}" \
            --arg status "${gate_statuses[$i]}" \
            --argjson duration "${gate_durations[$i]}" \
            --arg output "${gate_outputs[$i]}" \
            '{name: $name, status: $status, duration_s: $duration, output: $output}')")
    done
    printf '%s\n' "${gate_json_lines[@]}" | jq -s \
        --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --argjson passed "$([ "$failed" = 0 ] && echo true || echo false)" \
        '{generated_at: $generated_at, passed: $passed, gates: .}' \
        >"$_REPORT_PATH"
}

run_check() {
    local tree
    tree="$(git write-tree)"
    snapshot="$(mktemp -d -t osint-studio-gates-XXXXXX)"
    trap 'rm -rf "$snapshot"' EXIT

    git archive --format=tar "$tree" | tar -x -C "$snapshot"

    cd "$snapshot"
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

    gate shellcheck mise exec -- shellcheck "${_SHELL_FILES[@]}"
    gate shfmt mise exec -- shfmt -d "${_SHELL_FILES[@]}"
    gate actionlint mise exec -- actionlint "${_WORKFLOW_FILES[@]}"
    gate dprint mise exec -- dprint check
    gate lock-check mise exec -- pnpm install --frozen-lockfile

    if [ "$failed" = 0 ]; then
        gate eslint mise exec -- pnpm run lint
        gate prettier mise exec -- pnpm exec prettier --check .
        gate type-check mise exec -- pnpm run type-check
        gate build mise exec -- pnpm run build
        gate vitest mise exec -- pnpm run test
        gate markdownlint mise exec -- pnpm exec markdownlint-cli2 "**/*.md"
    fi

    cd "$root"
    write_report
    printf '%s\n' "$report"
    [ "$failed" = 0 ]
}

is_shell_file() {
    local needle="$1" candidate
    for candidate in "${_SHELL_FILES[@]}"; do
        [ "$needle" = "$candidate" ] && return 0
    done
    return 1
}

run_fix() {
    local files=("$@")
    if [ "${#files[@]}" -eq 0 ]; then
        mapfile -t files < <(git ls-files '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.json' '*.md' '*.css' '*.toml' '*.yaml' '*.yml' '*.sh' | sort -u)
        files+=("${_SHELL_FILES[@]}")
    fi

    local prettier_files=() eslint_files=() dprint_files=() markdownlint_files=() shfmt_files=()
    local file
    for file in "${files[@]}"; do
        [ -f "$file" ] || continue
        case "$file" in
        *.ts | *.tsx | *.js | *.jsx | *.mjs | *.json | *.md | *.css) prettier_files+=("$file") ;;
        esac
        case "$file" in
        *.ts | *.tsx | *.js | *.jsx | *.mjs) eslint_files+=("$file") ;;
        esac
        case "$file" in
        *.toml | *.yaml | *.yml) dprint_files+=("$file") ;;
        esac
        case "$file" in
        *.md) markdownlint_files+=("$file") ;;
        esac
        case "$file" in
        *.sh) shfmt_files+=("$file") ;;
        esac
        is_shell_file "$file" && shfmt_files+=("$file")
    done

    local did_something=0
    if [ "${#prettier_files[@]}" -gt 0 ]; then
        mise exec -- pnpm exec prettier --write "${prettier_files[@]}" >/dev/null 2>&1 || true
        echo "prettier: ${#prettier_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#eslint_files[@]}" -gt 0 ]; then
        mise exec -- pnpm exec eslint --fix "${eslint_files[@]}" >/dev/null 2>&1 || true
        echo "eslint --fix: ${#eslint_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#dprint_files[@]}" -gt 0 ]; then
        mise exec -- dprint fmt "${dprint_files[@]}" >/dev/null 2>&1 || true
        echo "dprint fmt: ${#dprint_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#shfmt_files[@]}" -gt 0 ]; then
        mise exec -- shfmt -w "${shfmt_files[@]}" >/dev/null 2>&1 || true
        echo "shfmt -w: ${#shfmt_files[@]} file(s)"
        did_something=1
    fi
    if [ "${#markdownlint_files[@]}" -gt 0 ]; then
        mise exec -- pnpm exec markdownlint-cli2 --fix "${markdownlint_files[@]}" >/dev/null 2>&1 || true
        echo "markdownlint --fix: ${#markdownlint_files[@]} file(s)"
        did_something=1
    fi
    [ "$did_something" = 0 ] && echo "fix: nothing to do"
    return 0
}

run_verify() {
    run_fix "$@" >/dev/null

    local out status=0
    out="$(run_check 2>&1)" || status=$?

    if [ "$status" = 0 ]; then
        echo "verify: ok"
    else
        printf '%s\n' "$out"
    fi

    echo
    echo "note: fix already runs automatically every turn and check already runs" \
        "at commit/merge — use verify only when you need the result before" \
        "either of those would."

    return "$status"
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
check) run_check ;;
fix) run_fix "$@" ;;
verify) run_verify "$@" ;;
*)
    echo "usage: scripts/run <check|fix|verify> [files...]" >&2
    exit 1
    ;;
esac
