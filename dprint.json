{
  "lineWidth": 120,
  "indentWidth": 2,
  "newLineKind": "lf",
  "toml": {
    "indentWidth": 2
  },
  "yaml": {
    "printWidth": 120,
    "indentWidth": 2,
    "lineBreak": "lf"
  },
  "markdown": {
    "textWrap": "always",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "unorderedListKind": "dashes",
    "headingKind": "atx"
  },
  "includes": ["**/*.toml", "**/*.yaml", "**/*.yml", "**/*.md"],
  "excludes": [
    "node_modules/",
    ".next/",
    ".cache/",
    ".git/",
    "coverage/",
    "pnpm-lock.yaml",
    "CHANGELOG.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm"
  ]
}
