{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mise",
            "args": [
              "exec",
              "--",
              "pnpm",
              "exec",
              "tsx",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/nudge-manual-checks.ts"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "mise",
            "args": [
              "exec",
              "--",
              "pnpm",
              "exec",
              "tsx",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report-comments.ts"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mise",
            "args": [
              "exec",
              "--",
              "pnpm",
              "exec",
              "tsx",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/report-uncommitted.ts"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "mise",
            "args": [
              "exec",
              "--",
              "pnpm",
              "exec",
              "tsx",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/mark-docs-nudge.ts"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise",
            "args": [
              "exec",
              "--",
              "pnpm",
              "exec",
              "tsx",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/after-turn.ts"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
